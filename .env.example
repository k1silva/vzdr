# Copie para .env e preencha. NUNCA commite o .env.

DATABASE_URL=postgresql://vzdr:dev@localhost:5432/vzdr

# Cluster de LABORATORIO. Credencial de producao nao entra na maquina de desenvolvimento.
LAB_OS_AUTH_URL=https://compute.lab.exemplo:5000/v3
LAB_OS_PROJECT_NAME=admin
LAB_OS_USERNAME=vzdr-service
LAB_OS_PASSWORD=
LAB_OS_USER_DOMAIN_NAME=Default
LAB_OS_PROJECT_DOMAIN_NAME=Default

# Host com libvirt real para testes de integracao
LIBVIRT_TEST_URI=qemu+ssh://root@lab-hv01/system
