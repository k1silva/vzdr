[Unit]
Description=Agente vzdr (replicacao, coleta)
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/vzdr/bin/vzdr-agent
Restart=always
RestartSec=10
Environment=VZDR_API_URL=https://vzdr.exemplo
EnvironmentFile=/etc/vzdr/agent.env

# O agente le discos de producao. Restricoes de seguranca ficam aqui.
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
